<?xml version="1.0" encoding="utf-8"?>
<!--
  Scanner-readable copy of the PackageReference items in VulnVb.vbproj.
  SDK-style projects ignore this file at build time. It exists because several SCA tools
  (OSV-Scanner among them) read packages.config but not PackageReference in a .vbproj.
  Keep the two in sync; manifest.json is the ground truth.
-->
<packages>
  <package id="Newtonsoft.Json" version="9.0.1" targetFramework="net8.0" />
  <package id="log4net" version="2.0.8" targetFramework="net8.0" />
  <package id="SharpZipLib" version="1.2.0" targetFramework="net8.0" />
  <package id="System.Text.Json" version="8.0.0" targetFramework="net8.0" />
</packages>
