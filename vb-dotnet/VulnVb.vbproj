<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>VulnVb</AssemblyName>
    <StartupObject>VulnVb.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>$(NoWarn);SYSLIB0011;BC40000</NoWarn>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <!-- Intentionally vulnerable dependency versions (SCA test targets). See manifest.json for CVE ground truth. -->
  <ItemGroup Condition="'$(OfflineVerify)' != 'true'">
    <PackageReference Include="Newtonsoft.Json" Version="9.0.1" />
    <PackageReference Include="log4net" Version="2.0.8" />
    <PackageReference Include="SharpZipLib" Version="1.2.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(OfflineVerify)' != 'true'">
    <DefineConstants>$(DefineConstants),WITH_DEPS</DefineConstants>
  </PropertyGroup>

  <!-- dotnet build -p:OfflineVerify=true compiles the code-level cases without restoring NuGet packages. -->
  <ItemGroup Condition="'$(OfflineVerify)' == 'true'">
    <Compile Remove="Deps\**" />
  </ItemGroup>

</Project>
